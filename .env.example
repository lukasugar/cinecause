# Database (Supabase Postgres)
# Example pooler URL:
# postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=postgresql://postgres.project_ref:password@aws-0-us-east-1.pooler.supabase.com:6543/postgres?sslmode=require
# Example direct URL (for admin tasks like db:push / db:studio):
# postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres?sslmode=require
DIRECT_URL=postgresql://postgres:password@db.project-ref.supabase.co:5432/postgres?sslmode=require

# Supabase Auth (public client keys)
NEXT_PUBLIC_SUPABASE_URL=https://project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key_here
# Server-side only. Required for admin operations like account deletion.
SUPABASE_SECRET_KEY=your_supabase_secret_key_here

# TMDB API
TMDB_API_KEY=your_tmdb_api_key_here

# Every.org
EVERY_ORG_API_KEY=your_every_org_api_key_here
# Base URL for Every.org nonprofit search API (partners/staging/etc.)
EVERY_ORG_SEARCH_API_BASE_URL=https://partners.every.org
EVERY_ORG_WEBHOOK_TOKEN=token_from_every_org_support
NEXT_PUBLIC_EVERY_ORG_WEBHOOK_TOKEN=token_from_every_org
# Use https://staging.every.org for testing, defaults to https://www.every.org
NEXT_PUBLIC_EVERY_ORG_URL=https://www.every.org
# Nonprofit slug for Every.org donation URL (wwf for prod, afatl for staging)
NEXT_PUBLIC_EVERY_ORG_NONPROFIT_SLUG=wwf

# Site URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000
